{
  "name": "vibe-translator",
  "productName": "vibe 번역기",
  "version": "1.3.0",
  "description": "A natural-language translator using your ChatGPT web session, without an API key.",
  "author": "vibe 번역기",
  "license": "MIT",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "local.baro.translate",
    "productName": "vibe 번역기",
    "directories": {
      "output": "build/installers"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "identity": null,
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "artifactName": "vibe-translator-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "artifactName": "vibe-translator-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "node scripts/package.cjs",
    "package:win": "node scripts/package.cjs win32",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:links": "node tests/linked-ui.cjs",
    "test:tone": "node tests/tone-ui.cjs"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "electron": "41.10.7",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "playwright-core": "1.62.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
